# Choose your AI provider: anthropic | openai | google | ollama
AI_PROVIDER=ollama

# Model to use (examples below)
# Anthropic: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5
# OpenAI:    gpt-5.4, gpt-5, gpt-5.2, gpt-4o, gpt-4.1, gpt-4.1-mini
# Google:    gemini-3-flash-preview, gemini-3.1-pro-preview, gemini-2.5-pro
# Ollama:    qwen2.5vl:7b, qwen2.5vl:32b, gemma3:27b (vision-capable local models)
AI_MODEL=gemma3:27b

# API Keys (set the one matching your provider — not needed for ollama)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Ollama base URL (default: http://192.168.1.9:11434)
# Change this if using a jumpserver/proxy to reach your Ollama instance
OLLAMA_BASE_URL="http://192.168.1.9:11434"
