# ┌──────────────────────────────────────────────────────────────┐
# │  INVOICE EXTRACTOR — Configuration                         │
# │  Change AI_PROVIDER and AI_MODEL to switch in one place    │
# └──────────────────────────────────────────────────────────────┘

# ── Provider & Model (uncomment ONE pair) ─────────────────────

# --- Ollama (local, free) ---
AI_PROVIDER=ollama
AI_MODEL=qwen3-vl:32b
# AI_MODEL=qwen2.5vl:32b
# AI_MODEL=qwen2.5vl:7b
# AI_MODEL=gemma3:27b

# --- Anthropic ---
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-6
# AI_MODEL=claude-opus-4-6
# AI_MODEL=claude-haiku-4-5

# --- OpenAI ---
# AI_PROVIDER=openai
# AI_MODEL=gpt-5.4
# AI_MODEL=gpt-5
# AI_MODEL=gpt-4o

# --- Google ---
# AI_PROVIDER=google
# AI_MODEL=gemini-2.5-flash
# AI_MODEL=gemini-2.5-pro
# AI_MODEL=gemini-3-flash-preview
# AI_MODEL=gemini-3.1-pro-preview

# ── API Keys (only needed for cloud providers) ───────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# ── Ollama Settings ──────────────────────────────────────────
# Change this if routing through a jumpserver/proxy
OLLAMA_BASE_URL="http://localhost:11434"
